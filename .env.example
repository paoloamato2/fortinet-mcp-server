# FortiOS MCP Server - Environment Variables
# Copy to .env and fill in your values

# FortiOS host (include https:// prefix)
FORTIOS_HOST=https://192.168.1.99

# API token (generate in FortiOS: System > Administrators > REST API Admin)
FORTIOS_API_TOKEN=your-api-token-here

# VDOM to target (default: root)
FORTIOS_VDOM=root

# Whether to verify the FortiOS SSL certificate (set to false for self-signed certs)
FORTIOS_VERIFY_SSL=false

# HTTP timeout in seconds
FORTIOS_TIMEOUT=30

# ── Multiple FortiGates ───────────────────────────────────────────────
# Point this at a JSON array of instances to manage several FortiGates from
# one server process. See fortigates.example.json.
# When set, FORTIOS_HOST above is ignored, and the file must exist and be
# valid — the server will not silently fall back to a single device.
# Use an absolute path — under Claude Desktop the server's working directory
# is usually not this repo, so a relative path like "./fortigates.json" will
# not resolve.
# FORTIOS_INSTANCES_FILE=/absolute/path/to/fortigates.json

# The FORTIOS_VDOM / FORTIOS_VERIFY_SSL / FORTIOS_TIMEOUT values above act as
# fleet-wide defaults for instances that omit those fields.
